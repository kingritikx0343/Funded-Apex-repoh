rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'kingritikx0343@gmail.com' ||
        request.auth.token.email == 'admin@fundedapex.com'
      );
    }

    // --- Users Collection (PII Isolated) ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && (incoming().role == 'user' || isAdmin());
      allow update: if isSignedIn() && isValidId(userId) && (
        (request.auth.uid == userId && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'uid', 'email', 'createdAt'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // --- Admins Registry ---
    match /admins/{adminId} {
      allow read, write: if isAdmin() && isValidId(adminId);
    }

    // --- Trading Accounts ---
    match /accounts/{accountId} {
      allow get: if isSignedIn() && isValidId(accountId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(accountId) && (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(accountId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() && isValidId(accountId);
    }

    // --- Orders ---
    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(orderId) && (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(orderId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // --- Purchase Requests ---
    match /purchaseRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(requestId) && (incoming().userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin() && isValidId(requestId);
    }

    // --- Verified Payouts Showcase ---
    match /payouts/{payoutId} {
      allow read: if isValidId(payoutId);
      allow write: if isAdmin() && isValidId(payoutId);
    }

    // --- Payment Deposit Settings ---
    match /paymentSettings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isAdmin() && isValidId(settingId);
    }

    // --- Admin Coupons ---
    match /adminCoupons/{couponId} {
      allow read: if isValidId(couponId);
      allow write: if isAdmin() && isValidId(couponId);
    }

    // --- Connection Test doc ---
    match /test/connection {
      allow read: if true;
    }
  }
}
