{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile and authentication details",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "country": { "type": "string", "maxLength": 64 },
        "referralCode": { "type": "string", "maxLength": 64 },
        "role": { "type": "string", "enum": ["user", "admin", "super_admin"] },
        "rewardPoints": { "type": "number" },
        "mfaEnabled": { "type": "boolean" },
        "deletionRequested": { "type": "boolean" },
        "avatarUrl": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "fullName", "email", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Trusted admin role registry document",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "role": { "type": "string", "enum": ["admin", "super_admin"] },
        "grantedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["email", "role"]
    },
    "TradingAccount": {
      "title": "TradingAccount",
      "description": "Prop trading account details and risk parameters",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "accountNumber": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "challengeId": { "type": "string", "maxLength": 64 },
        "challengeTitle": { "type": "string", "maxLength": 128 },
        "challengeType": { "type": "string", "maxLength": 32 },
        "accountSize": { "type": "number" },
        "startingBalance": { "type": "number" },
        "balance": { "type": "number" },
        "equity": { "type": "number" },
        "usedMargin": { "type": "number" },
        "freeMargin": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "passed", "breached", "completed", "failed"] },
        "terminalUserId": { "type": "string", "maxLength": 64 },
        "terminalPassword": { "type": "string", "maxLength": 64 },
        "profitTargetPct": { "type": "number" },
        "dailyDrawdownPct": { "type": "number" },
        "maxDrawdownPct": { "type": "number" },
        "minTradingDays": { "type": "number" },
        "tradingDaysCount": { "type": "number" },
        "leverage": { "type": "number" },
        "profitSplitPct": { "type": "number" },
        "currentStep": { "type": "number" },
        "totalSteps": { "type": "number" },
        "peakEquity": { "type": "number" },
        "dailyStartingEquity": { "type": "number" },
        "lastDailyResetDate": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "accountNumber", "userId", "accountSize", "balance", "equity", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Trading order ticket and execution details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ticketId": { "type": "string", "maxLength": 64 },
        "accountId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "symbol": { "type": "string", "maxLength": 32 },
        "side": { "type": "string", "enum": ["BUY", "SELL"] },
        "orderType": { "type": "string", "maxLength": 32 },
        "volume": { "type": "number" },
        "entryPrice": { "type": "number" },
        "currentPrice": { "type": "number" },
        "exitPrice": { "type": "number" },
        "stopLoss": { "type": "number" },
        "takeProfit": { "type": "number" },
        "grossPnl": { "type": "number" },
        "commission": { "type": "number" },
        "netPnl": { "type": "number" },
        "status": { "type": "string", "enum": ["OPEN", "CLOSED", "CANCELLED"] },
        "openTime": { "type": "string", "maxLength": 64 },
        "closeTime": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "accountId", "userId", "symbol", "side", "volume", "status"]
    },
    "PurchaseRequest": {
      "title": "PurchaseRequest",
      "description": "Evaluation challenge purchase request",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "userFullName": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "format": "email", "maxLength": 256 },
        "challengeId": { "type": "string", "maxLength": 64 },
        "challengeTitle": { "type": "string", "maxLength": 128 },
        "accountSize": { "type": "number" },
        "originalPriceUsd": { "type": "number" },
        "discountPct": { "type": "number" },
        "finalAmountUsd": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 32 },
        "transactionRef": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "allocatedAccountNumber": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "reviewedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "userEmail", "finalAmountUsd", "status"]
    },
    "Payout": {
      "title": "Payout",
      "description": "Public proof of verified payout to funded trader",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "traderName": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "amountUsd": { "type": "number" },
        "currency": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "maxLength": 32 },
        "paymentDate": { "type": "string", "maxLength": 32 },
        "accountSize": { "type": "number" },
        "programType": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "traderName", "amountUsd", "status", "paymentDate"]
    },
    "PaymentSettings": {
      "title": "PaymentSettings",
      "description": "Administrative crypto deposit addresses and instructions",
      "type": "object",
      "properties": {
        "cryptoUsdtTrc20": { "type": "string", "maxLength": 256 },
        "cryptoUsdtErc20": { "type": "string", "maxLength": 256 },
        "cryptoUsdtBep20": { "type": "string", "maxLength": 256 },
        "cryptoBtcAddress": { "type": "string", "maxLength": 256 },
        "cryptoEthAddress": { "type": "string", "maxLength": 256 },
        "cryptoSolAddress": { "type": "string", "maxLength": 256 },
        "cryptoUsdtTrc20Qr": { "type": "string", "maxLength": 100000 }
      },
      "required": ["cryptoUsdtTrc20"]
    },
    "AdminCoupon": {
      "title": "AdminCoupon",
      "description": "Discount coupon code for evaluations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 64 },
        "discountPct": { "type": "number" },
        "description": { "type": "string", "maxLength": 256 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "code", "discountPct", "active"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Protected user profile records"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Protected administrative registry"
    },
    "/accounts/{accountId}": {
      "schema": "TradingAccount",
      "description": "Trading accounts assigned to users"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Market and limit trading orders"
    },
    "/purchaseRequests/{requestId}": {
      "schema": "PurchaseRequest",
      "description": "Evaluation plan purchase requests"
    },
    "/purchase_requests/{requestId}": {
      "schema": "PurchaseRequest",
      "description": "Evaluation plan purchase requests (snake_case alias)"
    },
    "/mail_notifications/{mailId}": {
      "schema": "object",
      "description": "System email notification logs"
    },
    "/payouts/{payoutId}": {
      "schema": "Payout",
      "description": "Public trader payouts showcase"
    },
    "/paymentSettings/{settingId}": {
      "schema": "PaymentSettings",
      "description": "Cryptocurrency deposit configurations"
    },
    "/adminCoupons/{couponId}": {
      "schema": "AdminCoupon",
      "description": "Official discount coupon codes"
    }
  }
}
