{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered user profile and account metadata with isolated PII",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Full legal or display name of the trader",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address",
          "maxLength": 150
        },
        "country": {
          "type": "string",
          "description": "Country of residence",
          "minLength": 1,
          "maxLength": 80
        },
        "referralCode": {
          "type": "string",
          "description": "Unique referral code for this user",
          "maxLength": 32
        },
        "referredBy": {
          "type": "string",
          "description": "Optional referral code used at signup",
          "maxLength": 32
        },
        "role": {
          "type": "string",
          "description": "System role (always 'user' on client creation)",
          "enum": ["user", "support", "admin", "super_admin"]
        },
        "rewardPoints": {
          "type": "number",
          "description": "Accumulated reward points from spins and trading"
        },
        "lastSpinDate": {
          "type": "string",
          "description": "ISO date string of last free daily spin",
          "maxLength": 40
        },
        "mfaEnabled": {
          "type": "boolean",
          "description": "Whether multi-factor verification is enabled"
        },
        "deletionRequested": {
          "type": "boolean",
          "description": "Whether account deletion was requested"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": [
        "uid",
        "fullName",
        "email",
        "country",
        "referralCode",
        "role",
        "rewardPoints",
        "mfaEnabled",
        "deletionRequested",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator membership record",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "super_admin", "support"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "role", "createdAt"]
    },
    "TradingAccount": {
      "title": "TradingAccount",
      "description": "Evaluation or funded demo prop trading account belonging to a user",
      "type": "object",
      "properties": {
        "accountNumber": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userEmail": {
          "type": "string",
          "maxLength": 150
        },
        "userName": {
          "type": "string",
          "maxLength": 100
        },
        "challengeId": {
          "type": "string",
          "maxLength": 64
        },
        "challengeTitle": {
          "type": "string",
          "maxLength": 100
        },
        "challengeType": {
          "type": "string",
          "enum": ["one_step", "two_step", "three_step", "instant"]
        },
        "accountSize": {
          "type": "number"
        },
        "startingBalance": {
          "type": "number"
        },
        "balance": {
          "type": "number"
        },
        "equity": {
          "type": "number"
        },
        "usedMargin": {
          "type": "number"
        },
        "freeMargin": {
          "type": "number"
        },
        "profitTargetPct": {
          "type": "number"
        },
        "dailyDrawdownPct": {
          "type": "number"
        },
        "maxDrawdownPct": {
          "type": "number"
        },
        "minTradingDays": {
          "type": "number"
        },
        "tradingDaysCount": {
          "type": "number"
        },
        "leverage": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["available", "active", "passed", "failed", "suspended", "completed"]
        },
        "terminalUserId": {
          "type": "string",
          "maxLength": 64
        },
        "terminalPassword": {
          "type": "string",
          "maxLength": 64
        },
        "currentStep": {
          "type": "number"
        },
        "totalSteps": {
          "type": "number"
        },
        "profitSplitPct": {
          "type": "number"
        },
        "breachReason": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "accountNumber",
        "userId",
        "challengeId",
        "challengeTitle",
        "challengeType",
        "accountSize",
        "startingBalance",
        "balance",
        "equity",
        "usedMargin",
        "freeMargin",
        "profitTargetPct",
        "dailyDrawdownPct",
        "maxDrawdownPct",
        "minTradingDays",
        "tradingDaysCount",
        "leverage",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "TradeOrder": {
      "title": "TradeOrder",
      "description": "Simulated market or pending order and position record",
      "type": "object",
      "properties": {
        "ticketId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "accountId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "symbol": {
          "type": "string",
          "maxLength": 20
        },
        "side": {
          "type": "string",
          "enum": ["BUY", "SELL"]
        },
        "orderType": {
          "type": "string",
          "enum": ["MARKET", "BUY_LIMIT", "SELL_LIMIT", "BUY_STOP", "SELL_STOP"]
        },
        "volume": {
          "type": "number"
        },
        "entryPrice": {
          "type": "number"
        },
        "currentPrice": {
          "type": "number"
        },
        "exitPrice": {
          "type": "number"
        },
        "stopLoss": {
          "type": "number"
        },
        "takeProfit": {
          "type": "number"
        },
        "grossPnl": {
          "type": "number"
        },
        "commission": {
          "type": "number"
        },
        "netPnl": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["OPEN", "PENDING", "CLOSED", "CANCELLED"]
        },
        "openTime": {
          "type": "string",
          "maxLength": 40
        },
        "closeTime": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ticketId",
        "accountId",
        "userId",
        "symbol",
        "side",
        "orderType",
        "volume",
        "entryPrice",
        "currentPrice",
        "exitPrice",
        "stopLoss",
        "takeProfit",
        "grossPnl",
        "commission",
        "netPnl",
        "status",
        "openTime",
        "closeTime",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable audit log for administrator actions",
      "type": "object",
      "properties": {
        "adminId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "adminEmail": {
          "type": "string",
          "maxLength": 150
        },
        "action": {
          "type": "string",
          "maxLength": 100
        },
        "targetId": {
          "type": "string",
          "maxLength": 128
        },
        "details": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["adminId", "adminEmail", "action", "targetId", "details", "createdAt"]
    },
    "MailNotification": {
      "title": "MailNotification",
      "description": "Automated Cloud Function email dispatch record for terminal credentials",
      "type": "object",
      "properties": {
        "to": {
          "type": "string",
          "maxLength": 150
        },
        "recipientName": {
          "type": "string",
          "maxLength": 100
        },
        "sender": {
          "type": "string",
          "maxLength": 150
        },
        "domain": {
          "type": "string",
          "maxLength": 100
        },
        "accountId": {
          "type": "string",
          "maxLength": 128
        },
        "accountNumber": {
          "type": "string",
          "maxLength": 32
        },
        "challengeId": {
          "type": "string",
          "maxLength": 64
        },
        "challengeTitle": {
          "type": "string",
          "maxLength": 100
        },
        "terminalUserId": {
          "type": "string",
          "maxLength": 64
        },
        "terminalPassword": {
          "type": "string",
          "maxLength": 64
        },
        "subject": {
          "type": "string",
          "maxLength": 200
        },
        "htmlBody": {
          "type": "string",
          "maxLength": 10000
        },
        "textBody": {
          "type": "string",
          "maxLength": 5000
        },
        "triggeredBy": {
          "type": "string",
          "enum": ["admin_account_update", "admin_challenge_update", "account_allocation"]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "to",
        "recipientName",
        "sender",
        "domain",
        "accountId",
        "accountNumber",
        "challengeId",
        "challengeTitle",
        "terminalUserId",
        "terminalPassword",
        "subject",
        "htmlBody",
        "textBody",
        "triggeredBy",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles strictly isolated to owner and admins"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted admin lookup collection"
    },
    "/tradingAccounts/{accountId}": {
      "schema": { "$ref": "#/entities/TradingAccount" },
      "description": "User prop trading evaluation and funded accounts"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/TradeOrder" },
      "description": "User simulated orders, open positions, and trade history"
    },
    "/adminLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable administrator activity logs"
    },
    "/mail_notifications/{mailId}": {
      "schema": { "$ref": "#/entities/MailNotification" },
      "description": "Automated Cloud Function email notifications for terminal credentials"
    }
  }
}
